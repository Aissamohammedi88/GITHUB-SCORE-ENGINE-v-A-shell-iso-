class GitHubScorer:

def __init__(self, owner, repo):
self.owner = owner
self.repo = repo
self.repo_full = owner + "/" + repo
self.data = {}

def fetch_all(self):
info("Recuperation des donnees pour " + self.repo_full)

self.data["repo"] = api_get("/repos/" + self.repo_full)
if self.data["repo"].get("__error__"):
return False

self.data["languages"] = api_get("/repos/" + self.repo_full + "/languages")
self.data["contributors"] = api_get("/repos/" + self.repo_full + "/contributors?per_page=100")
self.data["commits"] = api_get("/repos/" + self.repo_full + "/commits?per_page=100")
self.data["releases"] = api_get("/repos/" + self.repo_full + "/releases?per_page=100")
self.data["branches"] = api_get("/repos/" + self.repo_full + "/branches?per_page=100")
self.data["tags"] = api_get("/repos/" + self.repo_full + "/tags?per_page=100")
self.data["issues_open"] = api_get("/repos/" + self.repo_full + "/issues?state=open&per_page=100")
self.data["issues_closed"] = api_get("/repos/" + self.repo_full + "/issues?state=closed&per_page=100")
self.data["pulls"] = api_get("/repos/" + self.repo_full + "/pulls?state=all&per_page=100")

# Root tree
default_branch = self.data["repo"].get("default_branch", "main")
self.data["tree"] = api_get("/repos/" + self.repo_full + "/git/trees/" + default_branch + "?recursive=1")

return True

# ───────────────────────────────────────────────────────────
# CALCULS PAR DIMENSION (chacun sur 100)
# ───────────────────────────────────────────────────────────
def score_popularity(self):
r = self.data["repo"]
stars = r.get("stargazers_count", 0)
forks = r.get("forks_count", 0)
watchers = r.get("subscribers_count", r.get("watchers_count", 0))

# Log scale (1 star = 10, 10 = 30, 100 = 50, 1000 = 70, 10000 = 90)
star_score = min(100, math.log10(max(1, stars) + 1) * 25)
fork_score = min(100, math.log10(max(1, forks) + 1) * 25)
watch_score = min(100, math.log10(max(1, watchers) + 1) * 20)

return round((star_score * 0.5 + fork_score * 0.3 + watch_score * 0.2), 2), {
"stars": stars,
"forks": forks,
"watchers": watchers,
}

def score_activity(self):
r = self.data["repo"]
pushed = r.get("pushed_at", "")
created = r.get("created_at", "")
updated = r.get("updated_at", "")

now = datetime.now(timezone.utc)

days_since_push = 9999
if pushed:
try:
dt = datetime.fromisoformat(pushed.replace("Z", "+00:00"))
days_since_push = (now - dt).days
except Exception:
pass

days_alive = 1
if created:
try:
dt = datetime.fromisoformat(created.replace("Z", "+00:00"))
days_alive = max(1, (now - dt).days)
except Exception:
pass

# Score sur fraicheur
if days_since_push <= 1:
freshness = 100
elif days_since_push <= 7:
freshness = 90
elif days_since_push <= 30:
freshness = 75
elif days_since_push <= 90:
freshness = 55
elif days_since_push <= 365:
freshness = 30
else:
freshness = 10

# Score sur historique
commits = self.data.get("commits", [])
commit_count = len(commits) if isinstance(commits, list) else 0
commit_score = min(100, math.log10(max(1, commit_count) + 1) * 33)

return round((freshness * 0.6 + commit_score * 0.4), 2), {
"days_since_push": days_since_push,
"days_alive": days_alive,
"recent_commits": commit_count,
}

def score_documentation(self):
r = self.data["repo"]
has_description = bool(r.get("description"))
has_homepage = bool(r.get("homepage"))
has_license = r.get("license") is not None
has_topics = len(r.get("topics", [])) > 0
has_wiki = r.get("has_wiki", False)
has_pages = r.get("has_pages", False)

# Fichiers cles
tree = self.data.get("tree", {})
files = []
if isinstance(tree, dict) and "tree" in tree:
files = [f["path"] for f in tree.get("tree", []) if f.get("type") == "blob"]

files_lower = [f.lower() for f in files]
has_readme = any("readme" in f for f in files_lower)
has_contributing = any("contributing" in f for f in files_lower)
has_code_of_conduct = any("code_of_conduct" in f or "code-of-conduct" in f for f in files_lower)
has_changelog = any("changelog" in f for f in files_lower)
has_security = any("security.md" in f for f in files_lower)
has_docs_folder = any(f.startswith("docs/") for f in files_lower)
has_examples = any("example" in f for f in files_lower)

score = 0
if has_description: score += 15
if has_homepage: score += 5
if has_license: score += 10
if has_topics: score += 5
if has_readme: score += 20
if has_contributing: score += 10
if has_code_of_conduct: score += 5
if has_changelog: score += 5
if has_security: score += 10
if has_docs_folder: score += 10
if has_examples: score += 5

return min(100, score), {
"description": has_description,
"homepage": has_homepage,
"license": has_license,
"topics": has_topics,
"readme": has_readme,
"contributing": has_contributing,
"code_of_conduct": has_code_of_conduct,
"changelog": has_changelog,
"security": has_security,
"docs_folder": has_docs_folder,
"examples": has_examples,
}

def score_quality(self):
r = self.data["repo"]
open_issues = r.get("open_issues_count", 0)

closed_issues = self.data.get("issues_closed", [])
closed_count = len(closed_issues) if isinstance(closed_issues, list) else 0

total_issues = open_issues + closed_count
if total_issues > 0:
resolution_rate = closed_count / total_issues
else:
resolution_rate = 0.5

# Si pas d'issues, neutre
if total_issues < 5:
issue_score = 50
else:
issue_score = resolution_rate * 100

# PRs
pulls = self.data.get("pulls", [])
pull_count = len(pulls) if isinstance(pulls, list) else 0
pr_score = min(100, math.log10(max(1, pull_count) + 1) * 40)

# Branches
branches = self.data.get("branches", [])
branch_count = len(branches) if isinstance(branches, list) else 0
branch_score = min(100, math.log10(max(1, branch_count) + 1) * 30)

return round((issue_score * 0.5 + pr_score * 0.25 + branch_score * 0.25), 2), {
"open_issues": open_issues,
"closed_issues": closed_count,
"resolution_rate": round(resolution_rate * 100, 1),
"pull_requests": pull_count,
"branches": branch_count,
}

def score_community(self):
contributors = self.data.get("contributors", [])
contributor_count = len(contributors) if isinstance(contributors, list) else 0

r = self.data["repo"]
forks = r.get("forks_count", 0)
watchers = r.get("subscribers_count", r.get("watchers_count", 0))

contributor_score = min(100, math.log10(max(1, contributor_count) + 1) * 40)
fork_score = min(100, math.log10(max(1, forks) + 1) * 25)
watch_score = min(100, math.log10(max(1, watchers) + 1) * 20)

# Network count = forks + contributors
network_score = min(100, math.log10(max(1, forks + contributor_count) + 1) * 30)

return round((contributor_score * 0.4 + fork_score * 0.3 + watch_score * 0.15 + network_score * 0.15), 2), {
"contributors": contributor_count,
"forks": forks,
"watchers": watchers,
}

def score_maintenance(self):
r = self.data["repo"]
is_archived = r.get("archived", False)
is_disabled = r.get("disabled", False)
is_fork = r.get("fork", False)

score = 100
if is_archived: score -= 40
if is_disabled: score -= 50
if is_fork: score -= 20

# Releases
releases = self.data.get("releases", [])
release_count = len(releases) if isinstance(releases, list) else 0
if release_count > 0:
score = min(100, score + 10)

# Tags
tags = self.data.get("tags", [])
tag_count = len(tags) if isinstance(tags, list) else 0
if tag_count > 3:
score = min(100, score + 5)

return max(0, min(100, score)), {
"archived": is_archived,
"disabled": is_disabled,
"is_fork": is_fork,
"releases": release_count,
"tags": tag_count,
}

def score_languages(self):
langs = self.data.get("languages", {})
if not isinstance(langs, dict) or not langs:
return 30, {"count": 0, "languages": {}}

total = sum(langs.values())
count = len(langs)

# Score basé sur le nombre de langages
lang_score = min(100, count * 15)

# Score basé sur la diversité
if total > 0:
top_lang_pct = max(langs.values()) / total
diversity_score = min(100, (1 - top_lang_pct) * 150)
else:
diversity_score = 0

return round((lang_score * 0.5 + diversity_score * 0.5), 2), {
"count": count,
"languages": {k: round(v / total * 100, 1) for k, v in langs.items()} if total > 0 else {},
}

def score_size(self):
r = self.data["repo"]
size_kb = r.get("size", 0)

if size_kb < 10:
score = 20
elif size_kb < 100:
score = 40
elif size_kb < 1000:
score = 65
elif size_kb < 10000:
score = 85
elif size_kb < 100000:
score = 100
else:
score = 90

return score, {"size_kb": size_kb, "size_mb": round(size_kb / 1024, 2)}

def score_all(self):
if not self.fetch_all():
return {"error": "Impossible de recuperer les donnees"}

pop_score, pop_data = self.score_popularity()
act_score, act_data = self.score_activity()
doc_score, doc_data = self.score_documentation()
qua_score, qua_data = self.score_quality()
com_score, com_data = self.score_community()
mai_score, mai_data = self.score_maintenance()
lan_score, lan_data = self.score_languages()
siz_score, siz_data = self.score_size()

# Score global (pondere)
weights = {
"popularity": 0.20,
"activity": 0.20,
"documentation": 0.15,
"quality": 0.15,
"community": 0.15,
"maintenance": 0.05,
"languages": 0.05,
"size": 0.05,
}

scores = {
"popularity": pop_score,
"activity": act_score,
"documentation": doc_score,
"quality": qua_score,
"community": com_score,
"maintenance": mai_score,
"languages": lan_score,
"size": siz_score,
}

global_score = sum(scores[k] * weights[k] for k in weights)

# Grade
if global_score >= 90:
grade = "S"
verdict = "EXCEPTIONNEL"
elif global_score >= 80:
grade = "A"
verdict = "EXCELLENT"
elif global_score >= 70:
grade = "B"
verdict = "TRES BON"
elif global_score >= 60:
grade = "C"
verdict = "BON"
elif global_score >= 50:
grade = "D"
verdict = "MOYEN"
elif global_score >= 35:
grade = "E"
verdict = "FAIBLE"
else:
grade = "F"
verdict = "DEBUTANT"

r = self.data["repo"]

return {
"ok": True,
"repo": {
"full_name": r.get("full_name"),
"description": r.get("description"),
"url": r.get("html_url"),
"homepage": r.get("homepage"),
"created_at": r.get("created_at"),
"pushed_at": r.get("pushed_at"),
"default_branch": r.get("default_branch"),
"license": (r.get("license") or {}).get("name") if r.get("license") else None,
"topics": r.get("topics", []),
"owner_avatar": (r.get("owner") or {}).get("avatar_url"),
"owner_url": (r.get("owner") or {}).get("html_url"),
},
"global_score": round(global_score, 2),
"grade": grade,
"verdict": verdict,
"scores": scores,
"details": {
"popularity": pop_data,
"activity": act_data,
"documentation": doc_data,
"quality": qua_data,
"community": com_data,
"maintenance": mai_data,
"languages": lan_data,
"size": siz_data,
},
"weights": weights,
"links": {
"repo": r.get("html_url"),
"issues": r.get("html_url") + "/issues",
"pulls": r.get("html_url") + "/pulls",
"releases": r.get("html_url") + "/releases",
"commits": r.get("html_url") + "/commits",
"contributors": r.get("html_url") + "/graphs/contributors",
"network": r.get("html_url") + "/network",
"wiki": r.get("html_url") + "/wiki",
"actions": r.get("html_url") + "/actions",
},
}


