class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


def local_ip():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "127.0.0.1"


def cli_score(url):
owner, repo = parse_repo_url(url)
if not owner or not repo:
err("URL GitHub invalide")
return
scorer = GitHubScorer(owner, repo)
result = scorer.score_all()
if result.get("error"):
err(result["error"])
return
print()
print(C + "=" * 60 + N)
print(C + " " + result["repo"]["full_name"] + N)
print(C + "=" * 60 + N)
print(" Score global : " + G + str(result["global_score"]) + " / 100" + N)
print(" Grade : " + G + result["grade"] + N)
print(" Verdict : " + result["verdict"])
print()
for k, v in result["scores"].items():
print(" " + k.ljust(15) + " : " + str(v).rjust(6) + " (" + str(int(result["weights"][k] * 100)) + "%)")
print()


def main():
if len(sys.argv) > 1 and sys.argv[1] not in ("--web",):
cli_score(sys.argv[1])
return

print()
