# ──────────────────────────────────────────────────────────────────────────
def compute_metrics(self):
r = self.data["repo"]

# Basic
self.metrics["stars"] = r.get("stargazers_count", 0)
self.metrics["forks"] = r.get("forks_count", 0)
self.metrics["watchers"] = r.get("subscribers_count", 0)
self.metrics["open_issues"] = r.get("open_issues_count", 0)
self.metrics["size_kb"] = r.get("size", 0)
self.metrics["size_mb"] = round(r.get("size", 0) / 1024, 2)
self.metrics["default_branch"] = r.get("default_branch", "main")
self.metrics["license"] = (r.get("license") or {}).get("name") if r.get("license") else "Aucune"
self.metrics["language"] = r.get("language", "Inconnu")
self.metrics["topics"] = r.get("topics", [])

# Dates
now = datetime.now(timezone.utc)

try:
created = datetime.fromisoformat(r["created_at"].replace("Z", "+00:00"))
self.metrics["created_at"] = created.isoformat()
self.metrics["age_days"] = (now - created).days
self.metrics["age_years"] = round((now - created).days / 365.25, 2)
except Exception:
self.metrics["age_days"] = 0
self.metrics["age_years"] = 0
created = now

try:
pushed = datetime.fromisoformat(r["pushed_at"].replace("Z", "+00:00"))
self.metrics["last_push"] = pushed.isoformat()
self.metrics["days_since_push"] = (now - pushed).days
except Exception:
self.metrics["days_since_push"] = 9999

try:
updated = datetime.fromisoformat(r["updated_at"].replace("Z", "+00:00"))
self.metrics["days_since_update"] = (now - updated).days
except Exception:
self.metrics["days_since_update"] = 9999

# Contributors
contributors = self.data.get("contributors", [])
if isinstance(contributors, list):
self.metrics["contributors"] = len(contributors)
self.metrics["top_contributors"] = [
{"login": c.get("login"), "contributions": c.get("contributions", 0),
"avatar": c.get("avatar_url"), "url": c.get("html_url")}
for c in contributors[:10]
]
else:
self.metrics["contributors"] = 0
self.metrics["top_contributors"] = []

# Commits
commits = self.data.get("commits", [])
if isinstance(commits, list):
self.metrics["recent_commits"] = len(commits)
self.metrics["commit_frequency"] = self._compute_commit_frequency(commits)
self.metrics["commit_heatmap"] = self._compute_heatmap(commits)
self.metrics["commit_authors"] = self._compute_authors(commits)
else:
self.metrics["recent_commits"] = 0
self.metrics["commit_frequency"] = {}
self.metrics["commit_heatmap"] = {}
self.metrics["commit_authors"] = {}

# Issues
issues_open = self.data.get("issues_open", [])
issues_closed = self.data.get("issues_closed", [])
self.metrics["issues_open_count"] = len(issues_open) if isinstance(issues_open, list) else 0
self.metrics["issues_closed_count"] = len(issues_closed) if isinstance(issues_closed, list) else 0
total_issues = self.metrics["issues_open_count"] + self.metrics["issues_closed_count"]
self.metrics["issues_total"] = total_issues
self.metrics["issue_resolution_rate"] = round(
self.metrics["issues_closed_count"] / total_issues * 100, 1
) if total_issues > 0 else 0.0

# PRs
pulls_open = self.data.get("pulls_open", [])
pulls_closed = self.data.get("pulls_closed", [])
self.metrics["pulls_open_count"] = len(pulls_open) if isinstance(pulls_open, list) else 0
self.metrics["pulls_closed_count"] = len(pulls_closed) if isinstance(pulls_closed, list) else 0

# Branches, tags, releases
self.metrics["branches"] = len(self.data.get("branches", [])) if isinstance(self.data.get("branches"), list) else 0
self.metrics["tags"] = len(self.data.get("tags", [])) if isinstance(self.data.get("tags"), list) else 0
self.metrics["releases"] = len(self.data.get("releases", [])) if isinstance(self.data.get("releases"), list) else 0

# Languages
langs = self.data.get("languages", {})
if isinstance(langs, dict) and langs:
total = sum(langs.values())
self.metrics["languages"] = {k: round(v / total * 100, 2) for k, v in langs.items()}
self.metrics["languages_count"] = len(langs)
else:
self.metrics["languages"] = {}
self.metrics["languages_count"] = 0

# Documentation
self.metrics["documentation"] = self._check_documentation()

# Traffic estimation
self.metrics["traffic"] = self._estimate_traffic()

# Health
self.metrics["health"] = self._compute_health()

def _compute_commit_frequency(self, commits):
"""Frequence de commits par mois sur les 12 derniers mois"""
months = defaultdict(int)
now = datetime.now(timezone.utc)

for c in commits:
try:
date_str = c.get("commit", {}).get("author", {}).get("date", "")
dt = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
key = dt.strftime("%Y-%m")
months[key] += 1
except Exception:
continue

# Remplir les 12 derniers mois
result = {}
for i in range(11, -1, -1):
d = now - timedelta(days=30 * i)
key = d.strftime("%Y-%m")
result[key] = months.get(key, 0)

return result

def _compute_heatmap(self, commits):
"""Heatmap par jour de la semaine x heure"""
heatmap = defaultdict(int)

for c in commits:
try:
date_str = c.get("commit", {}).get("author", {}).get("date", "")
dt = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
key = str(dt.weekday()) + "_" + str(dt.hour)
heatmap[key] += 1
except Exception:
continue

return dict(heatmap)

def _compute_authors(self, commits):
"""Repartition des commits par auteur"""
authors = Counter()
for c in commits:
try:
author = c.get("commit", {}).get("author", {}).get("name", "Inconnu")
authors[author] += 1
except Exception:
continue
return dict(authors.most_common(10))

def _check_documentation(self):
"""Verifie la presence des fichiers de doc"""
tree = self.data.get("tree", {})
files = []
if isinstance(tree, dict) and "tree" in tree:
files = [f.get("path", "") for f in tree.get("tree", []) if f.get("type") == "blob"]

files_lower = [f.lower() for f in files]

checks = {
"readme": any("readme" in f for f in files_lower),
"license": any(f.startswith("license") for f in files_lower),
"contributing": any("contributing" in f for f in files_lower),
"code_of_conduct": any("code_of_conduct" in f or "code-of-conduct" in f for f in files_lower),
"changelog": any("changelog" in f for f in files_lower),
"security": any("security" in f for f in files_lower),
"docs_folder": any(f.startswith("docs/") for f in files_lower),
"examples": any("example" in f for f in files_lower),
"tests": any("test" in f and (f.endswith(".py") or f.endswith(".js") or f.endswith(".go")) for f in files_lower),
"ci": any(f.startswith(".github/workflows/") for f in files_lower),
"dockerfile": any("dockerfile" in f for f in files_lower),
"makefile": any("makefile" in f for f in files_lower),
}

checks["score"] = round(sum(1 for v in checks.values() if v) / len(checks) * 100, 1)
checks["total_files"] = len(files)
return checks

def _estimate_traffic(self):
"""
Estimation du trafic (basé sur des formules observees)
Note: GitHub ne fournit le trafic reel que via l'API authentifiee
pour les repos dont on est proprietaire. Ici on estime.
"""
stars = self.metrics.get("stars", 0)
forks = self.metrics.get("forks", 0)
watchers = self.metrics.get("watchers", 0)
issues = self.metrics.get("issues_total", 0)
age_days = max(1, self.metrics.get("age_days", 1))

# Formule d'estimation basee sur ratios observes
# 1 star ~ 100 vues uniques initiales + 10 vues/mois continu
monthly_views_est = int(
(stars * 10) +
(forks * 30) +
(watchers * 5) +
(issues * 2) +
(age_days / 30 * 5)
)

weekly_views_est = int(monthly_views_est / 4.3)
daily_views_est = int(monthly_views_est / 30)

# Clones estimes (10% des vues)
monthly_clones_est = int(monthly_views_est * 0.15)

return {
"monthly_views_est": monthly_views_est,
"weekly_views_est": weekly_views_est,
"daily_views_est": daily_views_est,
"monthly_clones_est": monthly_clones_est,
"note": "Estimation basee sur ratios observes (stars, forks, watchers, age)",
}

def _compute_health(self):
"""Score de sante globale du repo"""
metrics = self.metrics

# Fraicheur
if metrics["days_since_push"] <= 7:
freshness = 100
elif metrics["days_since_push"] <= 30:
freshness = 80
elif metrics["days_since_push"] <= 90:
freshness = 60
elif metrics["days_since_push"] <= 365:
freshness = 35
else:
freshness = 10

# Resolution
resolution = metrics["issue_resolution_rate"]

# Documentation
doc_score = metrics["documentation"]["score"]

# Communaute
if metrics["contributors"] == 0:
community = 20
elif metrics["contributors"] == 1:
community = 40
elif metrics["contributors"] < 5:
community = 60
elif metrics["contributors"] < 20:
community = 80
else:
community = 100

# Activite
commit_count = metrics["recent_commits"]
if commit_count >= 100:
activity = 100
elif commit_count >= 50:
activity = 80
elif commit_count >= 20:
activity = 60
elif commit_count >= 5:
activity = 40
else:
activity = 20

health = (freshness * 0.3 + resolution * 0.2 + doc_score * 0.25 +
community * 0.15 + activity * 0.1)

return {
"score": round(health, 1),
"freshness": freshness,
"resolution": round(resolution, 1),
"documentation": doc_score,
"community": community,
"activity": activity,
}

# ──────────────────────────────────────────────────────────────────────────
# SCORES
# ──────────────────────────────────────────────────────────────────────────
def compute_scores(self):
m = self.metrics

# Popularite
star_score = min(100, math.log10(max(1, m["stars"]) + 1) * 25)
fork_score = min(100, math.log10(max(1, m["forks"]) + 1) * 25)
watch_score = min(100, math.log10(max(1, m["watchers"]) + 1) * 25)
self.scores["popularity"] = round(star_score * 0.6 + fork_score * 0.25 + watch_score * 0.15, 2)

# Activite
if m["days_since_push"] <= 1:
fresh = 100
elif m["days_since_push"] <= 7:
fresh = 90
elif m["days_since_push"] <= 30:
fresh = 75
elif m["days_since_push"] <= 90:
fresh = 50
elif m["days_since_push"] <= 365:
fresh = 25
else:
fresh = 5
commit_score = min(100, math.log10(max(1, m["recent_commits"]) + 1) * 35)
self.scores["activity"] = round(fresh * 0.6 + commit_score * 0.4, 2)

# Documentation
self.scores["documentation"] = m["documentation"]["score"]

# Qualite
issue_score = m["issue_resolution_rate"] if m["issues_total"] >= 5 else 50
pr_score = min(100, math.log10(max(1, m["pulls_open_count"] + m["pulls_closed_count"]) + 1) * 35)
branch_score = min(100, math.log10(max(1, m["branches"]) + 1) * 30)
self.scores["quality"] = round(issue_score * 0.5 + pr_score * 0.3 + branch_score * 0.2, 2)

# Communaute
contrib_score = min(100, math.log10(max(1, m["contributors"]) + 1) * 40)
fork_network = min(100, math.log10(max(1, m["forks"]) + 1) * 30)
self.scores["community"] = round(contrib_score * 0.6 + fork_network * 0.4, 2)

# Maintenance
r = self.data["repo"]
maintenance = 100
if r.get("archived"): maintenance -= 40
if r.get("disabled"): maintenance -= 50
if r.get("fork"): maintenance -= 20
if m["releases"] > 0: maintenance = min(100, maintenance + 10)
if m["tags"] > 3: maintenance = min(100, maintenance + 5)
self.scores["maintenance"] = max(0, maintenance)

# Langages
lang_score = min(100, m["languages_count"] * 15)
if m["languages"]:
top_pct = max(m["languages"].values())
diversity = min(100, (1 - top_pct / 100) * 150)
else:
diversity = 0
self.scores["languages"] = round(lang_score * 0.5 + diversity * 0.5, 2)

# Taille
size = m["size_kb"]
if size < 10: size_score = 20
elif size < 100: size_score = 40
elif size < 1000: size_score = 65
elif size < 10000: size_score = 85
elif size < 100000: size_score = 100
else: size_score = 90
self.scores["size"] = size_score

# Tendance (estimation)
self.scores["momentum"] = self._compute_momentum()

def _compute_momentum(self):
"""Estime la croissance du repo"""
commits = self.data.get("commits", [])
if not isinstance(commits, list) or not commits:
return 30

# Comparer activite recente vs ancienne
now = datetime.now(timezone.utc)
recent = 0
older = 0

for c in commits:
try:
date_str = c.get("commit", {}).get("author", {}).get("date", "")
dt = datetime.fromisoformat(date_str.replace("Z", "+00:00"))
days_ago = (now - dt).days
if days_ago <= 90:
recent += 1
elif days_ago <= 365:
older += 1
except Exception:
continue

if older == 0:
if recent > 10: return 90
if recent > 0: return 70
return 40

ratio = recent / older
if ratio > 2: return 100
if ratio > 1: return 85
if ratio > 0.5: return 65
if ratio > 0.2: return 45
return 25

def compute_global_score(self):
weights = {
"popularity": 0.20,
"activity": 0.20,
"documentation": 0.15,
"quality": 0.15,
"community": 0.15,
"maintenance": 0.05,
"languages": 0.05,
"size": 0.05,
}

global_score = sum(self.scores.get(k, 0) * w for k, w in weights.items())

# Bonus momentum
global_score = global_score * 0.95 + self.scores.get("momentum", 50) * 0.05

self.scores["global"] = round(global_score, 2)
self.scores["_weights"] = weights

# Grade
if global_score >= 90:
self.scores["grade"] = "S"
self.scores["verdict"] = "EXCEPTIONNEL"
self.scores["color"] = "#00ff9d"
elif global_score >= 80:
self.scores["grade"] = "A"
self.scores["verdict"] = "EXCELLENT"
self.scores["color"] = "#4ade80"
elif global_score >= 70:
self.scores["grade"] = "B"
self.scores["verdict"] = "TRES BON"
self.scores["color"] = "#a3e635"
elif global_score >= 60:
self.scores["grade"] = "C"
self.scores["verdict"] = "BON"
self.scores["color"] = "#fbbf24"
elif global_score >= 50:
self.scores["grade"] = "D"
self.scores["verdict"] = "MOYEN"
self.scores["color"] = "#fb923c"
elif global_score >= 35:
self.scores["grade"] = "E"
self.scores["verdict"] = "FAIBLE"
self.scores["color"] = "#f87171"
else:
self.scores["grade"] = "F"
self.scores["verdict"] = "DEBUTANT"
self.scores["color"] = "#ef4444"

