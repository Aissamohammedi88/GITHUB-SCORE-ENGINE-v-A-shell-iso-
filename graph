# MAIN
# ──────────────────────────────────────────────────────────────────────────
def analyze(self):
if not self.fetch():
return {"error": "Repo introuvable ou inaccessible"}

self.compute_metrics()
self.compute_scores()
self.compute_global_score()
self.build_graphs()

r = self.data["repo"]

return {
