self.graphs["authors"] = {
"type": "bar",
"labels": list(authors.keys()),
"values": list(authors.values()),
"title": "Top contributeurs (commits)",
}

# 4. Scores (radar)
score_labels = ["Popularite", "Activite", "Documentation", "Qualite",
