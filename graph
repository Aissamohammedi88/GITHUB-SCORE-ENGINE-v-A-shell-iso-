# HTTP HANDLER
# ══════════════════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8"):
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def do_GET(self):
p = urllib.parse.urlparse(self.path)
path = p.path
qs = urllib.parse.parse_qs(p.query)

if path in ("/", "/index.html"):
self._send(200, PAGE)

elif path == "/api/analyze":
url = qs.get("url", [""])[0]
if not url:
self._send(400, json.dumps({"error": "URL requise"}), "application/json")
return

owner, repo = parse_url(url)
if not owner or not repo:
self._send(400, json.dumps({"error": "URL GitHub invalide"}), "application/json")
return

client = GitHubClient(TOKEN)
engine = AnalyticsEngine(client, owner, repo)
result = engine.analyze()

self._send(200, json.dumps(result, ensure_ascii=False, default=str),
"application/json; charset=utf-8")

elif path == "/api/health":
self._send(200, json.dumps({
"status": "ok",
"version": VERSION,
"author": AUTHOR,
"has_token": bool(TOKEN),
}), "application/json")

else:
self._send(404, json.dumps({"error": "not found"}), "application/json")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
daemon_threads = True
allow_reuse_address = True


