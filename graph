function drawLine(canvasId, data){
var c = document.getElementById(canvasId);
if(!c) return;
var ctx = c.getContext('2d');
var W = c.width, H = c.height;
var pad = {l:50, r:20, t:20, b:40};
var cw = W - pad.l - pad.r;
var ch = H - pad.t - pad.b;
var values = data.values;
var labels = data.labels;
var maxV = Math.max.apply(null, values.concat([1]));

ctx.clearRect(0, 0, W, H);

// Grid
ctx.strokeStyle = '#1a0a28';
ctx.lineWidth = 1;
for(var i = 0; i <= 4; i++){
var y = pad.t + ch * i / 4;
ctx.beginPath();
ctx.moveTo(pad.l, y);
ctx.lineTo(pad.l + cw, y);
ctx.stroke();
}

// Y labels
ctx.fillStyle = '#666';
ctx.font = '10px monospace';
ctx.textAlign = 'right';
for(var i = 0; i <= 4; i++){
var y = pad.t + ch * i / 4;
var v = Math.round(maxV * (4 - i) / 4);
ctx.fillText(v, pad.l - 6, y + 3);
}

// Points
if(values.length < 2) return;
var stepX = cw / (values.length - 1);

// Area gradient
var grad = ctx.createLinearGradient(0, pad.t, 0, pad.t + ch);
grad.addColorStop(0, 'rgba(200,164,92,0.4)');
grad.addColorStop(1, 'rgba(200,164,92,0.0)');

ctx.beginPath();
ctx.moveTo(pad.l, pad.t + ch);
for(var i = 0; i < values.length; i++){
var x = pad.l + i * stepX;
var y = pad.t + ch - (values[i] / maxV) * ch;
ctx.lineTo(x, y);
}
ctx.lineTo(pad.l + cw, pad.t + ch);
ctx.closePath();
ctx.fillStyle = grad;
ctx.fill();

// Line
ctx.beginPath();
ctx.strokeStyle = '#c8a45c';
ctx.lineWidth = 2;
for(var i = 0; i < values.length; i++){
var x = pad.l + i * stepX;
var y = pad.t + ch - (values[i] / maxV) * ch;
if(i === 0) ctx.moveTo(x, y);
else ctx.lineTo(x, y);
}
ctx.stroke();

// Points
ctx.fillStyle = '#c8a45c';
for(var i = 0; i < values.length; i++){
var x = pad.l + i * stepX;
var y = pad.t + ch - (values[i] / maxV) * ch;
ctx.beginPath();
ctx.arc(x, y, 3, 0, Math.PI * 2);
ctx.fill();
}

// X labels
ctx.fillStyle = '#666';
ctx.font = '9px monospace';
ctx.textAlign = 'center';
for(var i = 0; i < labels.length; i += 2){
var x = pad.l + i * stepX;
ctx.fillText(labels[i], x, H - 10);
}
}

function drawPie(canvasId, data){
var c = document.getElementById(canvasId);
if(!c) return;
var ctx = c.getContext('2d');
var W = c.width, H = c.height;

ctx.clearRect(0, 0, W, H);

var cx = W / 2;
var cy = H / 2;
var r = Math.min(W, H) * 0.35;

var total = data.values.reduce(function(a, b){ return a + b; }, 0);
if(total === 0) return;

var colors = ['#c8a45c', '#4ade80', '#00d4ff', '#ff6ec7', '#fbbf24',
'#a78bfa', '#f87171', '#60a5fa', '#fb923c', '#34d399'];

var angle = -Math.PI / 2;

data.values.forEach(function(v, i){
var sliceAngle = (v / total) * Math.PI * 2;
ctx.beginPath();
ctx.moveTo(cx, cy);
ctx.arc(cx, cy, r, angle, angle + sliceAngle);
ctx.closePath();
ctx.fillStyle = colors[i % colors.length];
ctx.fill();
ctx.strokeStyle = '#0a0014';
ctx.lineWidth = 2;
ctx.stroke();

// Label
if(v / total > 0.05){
var midAngle = angle + sliceAngle / 2;
var lx = cx + Math.cos(midAngle) * r * 0.7;
var ly = cy + Math.sin(midAngle) * r * 0.7;
ctx.fillStyle = '#000';
ctx.font = 'bold 11px monospace';
ctx.textAlign = 'center';
ctx.textBaseline = 'middle';
ctx.fillText(Math.round(v) + '%', lx, ly);
}

angle += sliceAngle;
});

// Legend
ctx.font = '10px monospace';
ctx.textAlign = 'left';
ctx.textBaseline = 'middle';
var legendX = 20;
var legendY = 20;
data.labels.forEach(function(l, i){
ctx.fillStyle = colors[i % colors.length];
ctx.fillRect(legendX, legendY + i * 18, 12, 12);
ctx.fillStyle = '#ccc';
ctx.fillText(l + ' (' + data.values[i] + '%)', legendX + 18, legendY + i * 18 + 6);
});
}

function drawBars(canvasId, data){
var c = document.getElementById(canvasId);
if(!c) return;
var ctx = c.getContext('2d');
var W = c.width, H = c.height;
var pad = {l:60, r:20, t:20, b:40};
var cw = W - pad.l - pad.r;
var ch = H - pad.t - pad.b;

ctx.clearRect(0, 0, W, H);

var maxV = Math.max.apply(null, data.values.concat([1]));
var n = data.values.length;
var barW = cw / n * 0.6;
var gap = cw / n * 0.4;

// Grid
ctx.strokeStyle = '#1a0a28';
for(var i = 0; i <= 4; i++){
var y = pad.t + ch * i / 4;
ctx.beginPath();
ctx.moveTo(pad.l, y);
ctx.lineTo(pad.l + cw, y);
ctx.stroke();
}

data.values.forEach(function(v, i){
var x = pad.l + (barW + gap) * i + gap / 2;
var h = (v / maxV) * ch;
var y = pad.t + ch - h;

var grad = ctx.createLinearGradient(0, y, 0, y + h);
grad.addColorStop(0, '#c8a45c');
grad.addColorStop(1, '#4ade80');

ctx.fillStyle = grad;
ctx.fillRect(x, y, barW, h);

// Value
ctx.fillStyle = '#c8a45c';
ctx.font = 'bold 11px monospace';
ctx.textAlign = 'center';
ctx.fillText(v, x + barW / 2, y - 6);

// Label
ctx.fillStyle = '#888';
ctx.font = '10px monospace';
ctx.fillText(data.labels[i], x + barW / 2, H - 15);
});
}

function drawRadar(canvasId, data){
var c = document.getElementById(canvasId);
if(!c) return;
var ctx = c.getContext('2d');
var W = c.width, H = c.height;
var cx = W / 2, cy = H / 2;
var r = Math.min(W, H) * 0.35;

ctx.clearRect(0, 0, W, H);

var n = data.labels.length;
var angleStep = (Math.PI * 2) / n;

// Grid circles
ctx.strokeStyle = '#2a1a3a';
ctx.lineWidth = 1;
for(var ring = 1; ring <= 4; ring++){
ctx.beginPath();
for(var i = 0; i < n; i++){
var angle = -Math.PI / 2 + i * angleStep;
var x = cx + Math.cos(angle) * r * ring / 4;
var y = cy + Math.sin(angle) * r * ring / 4;
if(i === 0) ctx.moveTo(x, y);
else ctx.lineTo(x, y);
}
ctx.closePath();
ctx.stroke();
}

// Axes
ctx.strokeStyle = '#2a1a3a';
for(var i = 0; i < n; i++){
var angle = -Math.PI / 2 + i * angleStep;
var x = cx + Math.cos(angle) * r;
var y = cy + Math.sin(angle) * r;
ctx.beginPath();
ctx.moveTo(cx, cy);
ctx.lineTo(x, y);
ctx.stroke();
}

// Values
ctx.beginPath();
ctx.strokeStyle = '#c8a45c';
ctx.fillStyle = 'rgba(200,164,92,0.3)';
ctx.lineWidth = 2;
for(var i = 0; i < n; i++){
var angle = -Math.PI / 2 + i * angleStep;
var v = data.values[i] / 100;
var x = cx + Math.cos(angle) * r * v;
var y = cy + Math.sin(angle) * r * v;
if(i === 0) ctx.moveTo(x, y);
else ctx.lineTo(x, y);
}
ctx.closePath();
ctx.fill();
ctx.stroke();

// Points
ctx.fillStyle = '#4ade80';
for(var i = 0; i < n; i++){
var angle = -Math.PI / 2 + i * angleStep;
var v = data.values[i] / 100;
var x = cx + Math.cos(angle) * r * v;
var y = cy + Math.sin(angle) * r * v;
ctx.beginPath();
ctx.arc(x, y, 4, 0, Math.PI * 2);
ctx.fill();
}

// Labels
ctx.fillStyle = '#c8a45c';
ctx.font = '10px monospace';
ctx.textAlign = 'center';
ctx.textBaseline = 'middle';
for(var i = 0; i < n; i++){
var angle = -Math.PI / 2 + i * angleStep;
var x = cx + Math.cos(angle) * (r + 20);
var y = cy + Math.sin(angle) * (r + 20);
ctx.fillText(data.labels[i], x, y);
}
}

